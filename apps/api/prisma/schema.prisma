generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  watchlist   WatchlistItem[]
  analyses    AnalysisReport[]
  sessions    ChatSession[]
  messages    ChatMessage[]
  portfolio   PortfolioPosition[]
  alerts      PriceAlert[]
  settings    UserSettings?
  copyFollows CopyFollow[]
  copyTrades  CopyPaperTrade[]
}

model WatchlistItem {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  coingeckoId String
  symbol      String
  name        String
  createdAt   DateTime @default(now())

  @@unique([userId, coingeckoId])
  @@index([userId])
}

model AnalysisReport {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  coingeckoId String
  symbol      String
  name        String
  timeframe   String   @default("1d")
  sentiment   String
  score       Float
  summary     String
  thesis      String
  risks       String
  catalysts   String
  rawJson     String
  createdAt   DateTime @default(now())

  @@index([coingeckoId])
  @@index([userId])
}

model ChatSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages  ChatMessage[]

  @@index([userId])
}

model ChatMessage {
  id        String       @id @default(cuid())
  userId    String?
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId String?
  session   ChatSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String
  createdAt DateTime     @default(now())

  @@index([userId])
  @@index([sessionId])
}

model PortfolioPosition {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  coingeckoId String
  symbol      String
  name        String
  quantity    Float
  avgCostUsd  Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, coingeckoId])
  @@index([userId])
}

model PriceAlert {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  coingeckoId String
  symbol      String
  name        String
  direction   String
  targetPrice Float
  active      Boolean   @default(true)
  triggeredAt DateTime?
  createdAt   DateTime  @default(now())
  deliveries  AlertDelivery[]

  @@index([userId])
  @@index([active])
}

model AlertDelivery {
  id          String    @id @default(cuid())
  alertId     String
  alert       PriceAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  status      String    @default("pending")
  attempts    Int       @default(0)
  nextRetryAt DateTime  @default(now())
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, nextRetryAt])
  @@index([alertId])
}

model UserSettings {
  userId            String  @id
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName       String?
  defaultTimeframe  String  @default("1d")
  riskTolerance     String  @default("medium")
  emailAlerts       Boolean @default(false)
  telegramAlerts    Boolean @default(true)
  telegramChatId    String?
  signalStyle       String  @default("balanced")
  currency          String  @default("USD")
  updatedAt         DateTime @updatedAt
}

model CopyFollow {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  traderId      String
  allocationPct Float
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@unique([userId, traderId])
  @@index([userId])
}

model CopyPaperTrade {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  traderId    String
  coingeckoId String
  symbol      String
  name        String
  side        String
  quantity    Float
  priceUsd    Float
  notionalUsd Float
  note        String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([traderId])
}

/// Wallet intelligence (AlphaMind phase 3–4)
model TrackedWallet {
  id               String   @id @default(cuid())
  address          String
  chain            String   @default("solana")
  label            String?
  /// "rpc" = Solana ingest; "demo" = synthetic fills when offline
  source           String   @default("rpc")
  totalTrades      Int      @default(0)
  winningTrades    Int      @default(0)
  losingTrades     Int      @default(0)
  winRate          Float    @default(0)
  totalPnL         Float    @default(0)
  averagePnL       Float    @default(0)
  maxProfit        Float    @default(0)
  maxDrawdown      Float    @default(0)
  averageHoldTime  Float    @default(0)
  bestToken        String?
  worstToken       String?
  smartMoneyScore  Float    @default(50)
  lastSignature    String?
  lastIngestAt     DateTime?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  trades           WalletTrade[]
  events           WalletNormalizedEvent[]

  @@unique([chain, address])
  @@index([smartMoneyScore])
  @@index([active])
}

model WalletTrade {
  id             String        @id @default(cuid())
  walletId       String
  wallet         TrackedWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  coingeckoId    String?
  mintOrSymbol   String
  symbol         String
  side           String
  quantity       Float?
  priceUsd       Float?
  notionalUsd    Float?
  signature      String?
  blockTime      DateTime?
  createdAt      DateTime      @default(now())

  @@index([walletId])
  @@index([symbol, createdAt])
  @@index([createdAt])
  @@index([signature])
}

/// Normalized chain events from the ingest pipeline (phase 4)
model WalletNormalizedEvent {
  id         String        @id @default(cuid())
  walletId   String
  wallet     TrackedWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  chain      String        @default("SOLANA")
  signature  String
  tokenMint  String
  tokenSymbol String?
  type       String
  amount     Float
  valueUsd   Float?
  timestamp  DateTime
  rawJson    String?
  createdAt  DateTime      @default(now())

  @@unique([signature, walletId, tokenMint, type])
  @@index([walletId, timestamp])
  @@index([tokenMint, timestamp])
  @@index([type, timestamp])
}

/// Token holder distribution snapshots (AlphaMind phase 5)
model TokenHolderSnapshot {
  id                   String   @id @default(cuid())
  coingeckoId          String
  symbol               String
  holders              Int
  holderConcentration  Float
  top10Pct             Float
  top20Pct             Float
  smartMoneyOwnership  Float
  whaleOwnership       Float
  creatorOwnership     Float
  holderQualityScore   Float
  source               String   @default("estimated")
  createdAt            DateTime @default(now())

  @@index([coingeckoId, createdAt])
  @@index([symbol, createdAt])
}

/// Price history for the long-term pipeline (PostgreSQL)
model TokenPricePoint {
  id          String   @id @default(cuid())
  coingeckoId String
  symbol      String
  price       Float
  volume24h   Float?
  marketCap   Float?
  capturedAt  DateTime @default(now())

  @@index([coingeckoId, capturedAt])
  @@index([symbol, capturedAt])
}

/// Desk signals pushed to Telegram (phase 10)
model SignalEvent {
  id          String   @id @default(cuid())
  type        String
  coingeckoId String
  symbol      String
  name        String
  title       String
  body        String
  payloadJson String   @default("{}")
  fingerprint String   @unique
  createdAt   DateTime @default(now())
  deliveries  SignalDelivery[]

  @@index([type, createdAt])
  @@index([coingeckoId, createdAt])
}

model SignalDelivery {
  id          String    @id @default(cuid())
  signalId    String
  signal      SignalEvent @relation(fields: [signalId], references: [id], onDelete: Cascade)
  userId      String
  status      String    @default("pending")
  attempts    Int       @default(0)
  nextRetryAt DateTime  @default(now())
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([signalId, userId])
  @@index([status, nextRetryAt])
  @@index([userId])
}

/// Last known token metrics for change/drop signals
model TokenMetricSnapshot {
  id              String   @id @default(cuid())
  coingeckoId     String
  symbol          String
  name            String
  price           Float
  volume24h       Float
  marketCap       Float
  tokenScore      Float
  riskScore       Float
  liquidityScore  Float
  whaleOwnership  Float
  capturedAt      DateTime @default(now())

  @@index([coingeckoId, capturedAt])
}

/// Recorded Token Score observations + forward returns (phase 11)
model ScoredSignal {
  id           String    @id @default(cuid())
  coingeckoId  String
  symbol       String
  name         String
  score        Float
  signalPrice  Float
  source       String    @default("token-score")
  fingerprint  String    @unique
  ret5m        Float?
  ret15m       Float?
  ret1h        Float?
  ret6h        Float?
  ret24h       Float?
  price5m      Float?
  price15m     Float?
  price1h      Float?
  price6h      Float?
  price24h     Float?
  createdAt    DateTime  @default(now())

  @@index([score, createdAt])
  @@index([coingeckoId, createdAt])
}

/// Strategy backtest runs
model BacktestRun {
  id          String    @id @default(cuid())
  name        String
  paramsJson  String
  resultJson  String?
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?
}

