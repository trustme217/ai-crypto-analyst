generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  watchlist   WatchlistItem[]
  analyses    AnalysisReport[]
  sessions    ChatSession[]
  messages    ChatMessage[]
  portfolio   PortfolioPosition[]
  alerts      PriceAlert[]
  settings    UserSettings?
  copyFollows CopyFollow[]
  copyTrades  CopyPaperTrade[]
}

model WatchlistItem {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  coingeckoId String
  symbol      String
  name        String
  createdAt   DateTime @default(now())

  @@unique([userId, coingeckoId])
  @@index([userId])
}

model AnalysisReport {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  coingeckoId String
  symbol      String
  name        String
  timeframe   String   @default("1d")
  sentiment   String
  score       Float
  summary     String
  thesis      String
  risks       String
  catalysts   String
  rawJson     String
  createdAt   DateTime @default(now())

  @@index([coingeckoId])
  @@index([userId])
}

model ChatSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages  ChatMessage[]

  @@index([userId])
}

model ChatMessage {
  id        String       @id @default(cuid())
  userId    String?
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId String?
  session   ChatSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String
  createdAt DateTime     @default(now())

  @@index([userId])
  @@index([sessionId])
}

model PortfolioPosition {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  coingeckoId String
  symbol      String
  name        String
  quantity    Float
  avgCostUsd  Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, coingeckoId])
  @@index([userId])
}

model PriceAlert {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  coingeckoId String
  symbol      String
  name        String
  direction   String
  targetPrice Float
  active      Boolean   @default(true)
  triggeredAt DateTime?
  createdAt   DateTime  @default(now())
  deliveries  AlertDelivery[]

  @@index([userId])
  @@index([active])
}

model AlertDelivery {
  id          String    @id @default(cuid())
  alertId     String
  alert       PriceAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  status      String    @default("pending")
  attempts    Int       @default(0)
  nextRetryAt DateTime  @default(now())
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, nextRetryAt])
  @@index([alertId])
}

model UserSettings {
  userId            String  @id
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName       String?
  defaultTimeframe  String  @default("1d")
  riskTolerance     String  @default("medium")
  emailAlerts       Boolean @default(false)
  telegramAlerts    Boolean @default(true)
  telegramChatId    String?
  signalStyle       String  @default("balanced")
  currency          String  @default("USD")
  updatedAt         DateTime @updatedAt
}

model CopyFollow {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  traderId      String
  allocationPct Float
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@unique([userId, traderId])
  @@index([userId])
}

model CopyPaperTrade {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  traderId    String
  coingeckoId String
  symbol      String
  name        String
  side        String
  quantity    Float
  priceUsd    Float
  notionalUsd Float
  note        String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([traderId])
}
